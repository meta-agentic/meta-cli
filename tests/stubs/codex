#!/usr/bin/env bash
# Headless codex stub: echoes argv and a codex-shaped token total (no network).
set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
  echo "stub-codex 0.0.0"
  exit 0
fi

printf 'args=%s\n' "$*"
# Distinguish unset from a leaked gemini trust export.
printf 'GEMINI_CLI_TRUST_WORKSPACE=%s\n' "${GEMINI_CLI_TRUST_WORKSPACE-<unset>}"
printf 'tokens used\n'
printf '%s\n' "${META_STUB_CODEX_USAGE:-1,234}"
exit 0
